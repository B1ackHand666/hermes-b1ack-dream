{
  "name": "hermes-b1ack-dream",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes B1ack Dream: independent, user-controlled long-term memory provider for Hermes.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "npm run build && node --test dist/tests/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
